# Copy to tradex-rag/.env once. start.sh loads this backend-only file.
# Default: local embeddings and cited excerpts, no paid API calls.
TRADEX_EMBEDDING=bge-local
TRADEX_TENANT=demo-exporter
TRADEX_ACTOR=local-user

# Optional Qwen chat: fill BOTH values and change CHAT_ENABLED to 1.
# Copy the compatible base URL from the same regional workspace as the key.
# Beijing example:
# https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Singapore example:
# https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
TRADEX_CHAT_ENABLED=0
TRADEX_CHAT_MODEL=qwen-plus

# Optional backend port (default 8765); match the frontend proxy setting.
# TRADEX_RAG_PORT=8765
# Optional Qdrant server instead of embedded local storage:
# QDRANT_URL=http://127.0.0.1:6333
# Optional hosted embeddings: change TRADEX_EMBEDDING to dashscope,
# configure the credentials above, and reindex into the new collection.
# TRADEX_EMBEDDING_MODEL=text-embedding-v4
# TRADEX_EMBEDDING_DIMENSIONS=1024

# TradeX main agent + business subagents
TRADEX_AGENTS_ENABLED=1
TRADEX_MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
TRADEX_MODEL=deepseek/deepseek-v4.1-flash
TRADEX_MODEL_CONCURRENCY=2
TRADEX_AGENT_MAX_CALLS=18

# Image understanding uses the same provider/key, with a dedicated vision model.
# Set a vision-capable model when changing providers.
TRADEX_MODEL_VISION=qwen/qwen3.5-plus-20260420
