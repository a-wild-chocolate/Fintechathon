# Local BGE works without API keys; start.sh reads environment variables.
TRADEX_EMBEDDING=bge-local
TRADEX_TENANT=demo-exporter
TRADEX_ACTOR=local-user
# Optional server instead of embedded Qdrant:
# QDRANT_URL=http://127.0.0.1:6333
# To create a NEW Qwen vector collection, set the following then reindex:
# TRADEX_EMBEDDING=dashscope
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# TRADEX_EMBEDDING_MODEL=text-embedding-v4
# TRADEX_EMBEDDING_DIMENSIONS=1024
# Optional Qwen answers. The browser never receives this key.
# Enable only after selecting your regional endpoint and supplying the key above.
TRADEX_CHAT_ENABLED=0
TRADEX_CHAT_MODEL=qwen-plus
